POSTGRES_DB=document_checker
POSTGRES_USER=document_checker
POSTGRES_PASSWORD=replace-this-local-password

# Kept fixed by the product brief. No OpenAI API key is used.
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=medium

# Local OCR for scanned PDFs (the Compose image includes Poppler and Tesseract).
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_DPI=200
OCR_MAX_PAGES=100
OCR_TIMEOUT_SECONDS=90
OCR_MAX_CHARS=5000000
